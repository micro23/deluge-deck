{
  "name": "deluge-deck",
  "version": "1.0.30",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node server/index.mjs\"",
    "build": "vite build",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "start": "node server/index.mjs",
    "demo": "DELUGE_DEMO=1 node server/index.mjs",
    "verify:deluge": "node scripts/verify-deluge.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:check": "npm test && npm run check && npm run verify:release",
    "test": "node --test server/*.test.mjs",
    "check": "vite build && node --check server/index.mjs && node --check server/hosted-layout-fixture.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "devDependencies": {}
}
